{
  "name": "@newhighsco/.github",
  "version": "1.2.99",
  "description": "New High Score default templates",
  "author": "New High Score",
  "license": "ISC",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/newhighsco/.github.git"
  },
  "homepage": "https://github.com/newhighsco/github#readme",
  "bugs": {
    "url": "https://github.com/newhighsco/github/issues"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "prepare": "husky",
    "test": "yarn lint",
    "lint": "concurrently 'yarn:lint:*'",
    "lint:js": "yarn eslint --cache .",
    "lint:renovate": "renovate-config-validator renovate-config.json --strict",
    "format": "concurrently 'yarn:format:*'",
    "format:js": "yarn lint:js --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@newhighsco/commitlint-config": "1.3.8",
    "@newhighsco/editor-config": "1.2.0",
    "@newhighsco/eslint-config": "7.1.69",
    "@newhighsco/lint-staged-config": "1.1.4",
    "@newhighsco/prettier-config": "2.3.19",
    "@newhighsco/release-config": "1.5.12",
    "@newhighsco/yarn-plugin-preset": "1.1.4",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "renovate": "44.239.1",
    "semantic-release": "25.0.9"
  },
  "resolutions": {
    "conventional-changelog-conventionalcommits": "9.3.1"
  },
  "commitlint": {
    "extends": [
      "@newhighsco"
    ]
  },
  "prettier": "@newhighsco/prettier-config",
  "release": {
    "extends": "@newhighsco/release-config"
  }
}
